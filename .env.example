# ════════════════════════════════════════════════════════════════════════════
#  Yuna — Bot de Música do Discord (SAO: Ordinal Scale)
# ════════════════════════════════════════════════════════════════════════════
# 1. Copie este arquivo:   cp .env.example .env    (Windows: copy .env.example .env)
# 2. Cole o token do bot (Developer Portal → Applications → seu app → Bot →
#    "Reset Token"). Nunca compartilhe e nunca commite o .env!
# ════════════════════════════════════════════════════════════════════════════

DISCORD_TOKEN=cole_o_token_do_bot_aqui

# Nível de log no console: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# (Opcional) Nome/caminho do arquivo de cookies do YouTube, em formato Netscape.
# Se esta variável for omitida, a Yuna procura "cookies.txt" na raiz do projeto.
# YUNA_COOKIES_FILE=cookies.txt
